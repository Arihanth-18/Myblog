PORT=4000

# --- Admin login (CHANGE THESE) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-string

# --- Neon (PostgreSQL) ---
# Neon dashboard -> your project -> "Connect" -> copy the connection string.
# Tables are created automatically on first start. Keep it exactly as Neon gives it (with ?sslmode=require).
# Leaving this empty falls back to a local file (backend/data/db.json) - fine for trying it out, not for hosting.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Optional ---
# Only needed if the frontend is hosted on a different domain than the API.
# Comma-separated list of allowed origins, no trailing slash.
FRONTEND_URL=
# Public URL of the site (used for absolute links in the RSS feed).
SITE_URL=http://localhost:4000
